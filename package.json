{
  "name": "agent-worlds",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/contracts/*.test.ts tests/integration/*.test.ts packages/local-line/tests/*.test.ts tests/packaging/*.test.mjs",
    "test:contract": "node --experimental-strip-types --test tests/contracts/*.test.ts tests/integration/*.test.ts",
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "dev": "node dev/server.mjs",
    "check": "npm run typecheck && npm test && npm run package"
  },
  "dependencies": {
    "@babylonjs/core": "9.26.0",
    "@babylonjs/loaders": "9.26.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
